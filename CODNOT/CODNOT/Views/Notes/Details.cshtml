@model ASP.NET_CodeNotes.Models.Note

@{
    ViewData["Title"] = "Детали";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@Model.Title</h2>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-controller="Notes" asp-action="Edit" asp-route-id="@Model.Id">Редактировать</a>
        <form asp-controller="Notes" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-danger" type="submit" onclick="return confirm('Удалить заметку?');">Удалить</button>
        </form>
    </div>
</div>

<div class="mb-2 text-muted">
    Создано: @Model.CreatedAt.ToLocalTime().ToString("f")
</div>

@if (Model.NoteTags.Any())
{
    <div class="mb-3">
        @foreach (var t in Model.NoteTags.Select(nt => nt.Tag.Name).Distinct())
        {
            <span class="badge text-bg-light border me-1">@t</span>
        }
    </div>
}

<pre class="p-3 border rounded bg-light">@Model.Content</pre>

<a class="btn btn-link px-0" asp-controller="Notes" asp-action="Index">← К списку</a>

