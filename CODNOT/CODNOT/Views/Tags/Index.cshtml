@model IReadOnlyList<ASP.NET_CodeNotes.Models.Tag>

@{
    ViewData["Title"] = "Теги";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Теги</h2>
    <a class="btn btn-primary" asp-controller="Tags" asp-action="Create">Создать</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-secondary">Пока нет тегов.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Название</th>
                <th class="text-end">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.Name</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Tags" asp-action="Edit" asp-route-id="@t.Id">Редактировать</a>
                        <form asp-controller="Tags" asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Удалить тег?');">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

